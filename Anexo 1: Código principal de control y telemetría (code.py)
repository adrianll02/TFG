def parse_speed(value):
    try:
        return max(0, min(100, int(value)))
    except Exception:
        return None


def parse_seconds(value):
    try:
        return max(0.0, float(value))
    except Exception:
        return None


def extract_timing(tokens):
    speed_override = None
    duration = None
    cleaned = []
    idx = 0
    while idx < len(tokens):
        tok = tokens[idx]
        low = tok.lower()
        if low in ("vel", "speed") and idx + 1 < len(tokens):
            candidate = parse_speed(tokens[idx + 1])
            if candidate is not None:
                speed_override = candidate
                idx += 2
                continue
        if low in ("ts", "t", "time", "tiempo", "seg", "segundos", "s") and idx + 1 < len(tokens):
            candidate = parse_seconds(tokens[idx + 1])
            if candidate is not None:
                duration = candidate
                idx += 2
                continue
        cleaned.append(tok)
        idx += 1
    return cleaned, speed_override, duration


def set_motor_speed(value):
    global motor_speed
    parsed = parse_speed(value)
    if parsed is None:
        print("[warn] Velocidad invalida:", value)
        return motor_speed
    motor_speed = parsed
    print("[info] Velocidad base ->", motor_speed)
    return motor_speed


def robot_move(direction, speed=None):
    global last_move, motor_speed
    if motor_speed is None:
        motor_speed = parse_speed(MOTOR_DEFAULT_SPEED) or 35

    cmd = str(direction).lower()
    now = time.monotonic()
    if speed is None:
        speed_value = motor_speed
    else:
        parsed = parse_speed(speed)
        if parsed is None:
            print("[warn] Velocidad invalida, usando", motor_speed)
            speed_value = motor_speed
        else:
            motor_speed = parsed
            speed_value = parsed

    print("[cmd] Movimiento ->", cmd, "@", speed_value)

    stop_cmds = {"stop", "idle", "halt", "brake", "neutral"}
    if not motor:
        last_move.update({"direction": cmd, "speed": 0 if cmd in stop_cmds else speed_value, "when": now})
        return
    try:
        if cmd in stop_cmds:
            if hasattr(motor, "motor_stop"):
                motor.motor_stop()
            elif hasattr(motor, "stop"):
                motor.stop()
            elif hasattr(motor, "move"):
                motor.move(0, "stop", 0)
        elif hasattr(motor, "move"):
            motor.move(1, cmd, speed_value)
        elif hasattr(motor, cmd):
            getattr(motor, cmd)()
    except Exception as e:
        print("[warn] Motor error:", e)
    finally:
        last_move.update({
            "direction": "stop" if cmd in stop_cmds else cmd,
            "speed": 0 if cmd in stop_cmds else speed_value,
            "when": now,
        })
        update_matrix(last_move["direction"])


def robot_servo(value):
    global last_servo_pos
    try:
        angle = int(value)
    except Exception:
        print("[warn] Valor de servo invalido:", value)
        return
    last_servo_pos = angle
    if not servo:
        return
    try:
        if hasattr(servo, "set_angle"):
            tgt_pin = servo_pin or getattr(servo, "pin", None)
            if tgt_pin is not None:
                servo.set_angle(tgt_pin, angle)
            else:
                servo.set_angle(angle)
        elif hasattr(servo, "angle"):
            servo.angle = angle
        elif hasattr(servo, "move"):
            servo.move(angle)
    except Exception as e:
        print("[warn] Servo error:", e)


