def load_settings(path="/settings.toml"):
    cfg = {}
    try:
        with open(path, "r") as f:
            for raw in f:
                line = raw.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                key, value = [part.strip() for part in line.split("=", 1)]
                if value and ((value[0] == value[-1]) and value[0] in "\"\'"):
                    value = value[1:-1]
                try:
                    value = int(value)
                except Exception:
                    pass
                cfg[key] = value
    except Exception:
        pass
    return cfg

