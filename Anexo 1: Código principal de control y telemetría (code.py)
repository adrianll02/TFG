def update_matrix(direction):
    if not matrix_display:
        return

    key = str(direction).lower() if direction is not None else "stop"
    pattern = MATRIX_PATTERNS.get(key, MATRIX_PATTERNS["stop"])

    try:
        matrix_display.fill(0)
        for row, row_data in enumerate(pattern):
            for col, char in enumerate(row_data[:16]):
                if char != ".":
                    matrix_display.pixel(col, row, 1)
        matrix_display.show()
    except Exception as err:
        print("[warn] LED matrix write error:", err)


def lcd_show(content):
    global last_lcd_text
    if not lcd_display or not hasattr(lcd_display, "lcd"):
        print("[warn] LCD no disponible")
        return

    try:
        if isinstance(content, (list, tuple)):
            lines = [str(part) for part in content]
        else:
            lines = str(content).splitlines() if content not in (None, "") else [""]

        if not lines:
            lines = [""]

        formatted = []
        for line in lines[:2]:
            formatted.append(line[:16])
        while len(formatted) < 2:
            formatted.append("")

        lcd_display.lcd.clear()
        lcd_display.lcd.print(formatted[0])
        lcd_display.lcd.print("\n")
        lcd_display.lcd.print(formatted[1])

        last_lcd_text = tuple(formatted)
    except Exception as e:
        print("[warn] LCD write error:", e)


