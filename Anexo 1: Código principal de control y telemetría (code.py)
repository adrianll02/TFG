# --- Programa principal ---------------------------------------------------

def main():
    global last_status, motor_speed, publish_sequence

    if motor_speed is None:
        motor_speed = parse_speed(MOTOR_DEFAULT_SPEED) or 35

    if not SSID or not PASSWORD:
        print("[warn] settings.toml no tiene CIRCUITPY_WIFI_SSID / PASSWORD")
        return
    if not BROKER:
        print("[warn] settings.toml no tiene MQTT_BROKER")
        return

    print("[🌐] Conectando WiFi...", SSID)
    try:
        wifi.radio.connect(SSID, PASSWORD)
        print("[✅] WiFi OK, IP:", wifi.radio.ipv4_address)
    except Exception as e:
        print("[❌] Error WiFi:", e)
        return

    pool = socketpool.SocketPool(wifi.radio)

    try:
        client = MQTT(
            broker=BROKER,
            port=PORT,
            client_id="robot-" + str(int(time.monotonic())),
            socket_pool=pool,
        )
    except Exception as e:
        print("[error] MQTT init fallo:", e)
        return

    client.on_connect = on_connect
    client.on_message = on_message

    print("[🔌] Conectando a broker %s:%d..." % (BROKER, PORT))
    try:
        client.connect()
    except Exception as e:
        print("[error] MQTT connect() fallo:", e)
        return

    initial_now = time.monotonic()
    last_status = gather_status(initial_now)
    last_status["ping"] = 0
    last_status["ping_ms"] = 0
    last_status["seq"] = 0
    update_dashboard_status(last_status)

    start_dashboard(
        pool,
        wifi.radio,
        HTTP_PORT,
        handle_command,
        lambda: last_status,
        format_status_lines,
        HTTP_USER,
        HTTP_PASSWORD,
    )

    last = initial_now
    last_terminal_print = initial_now
    counter = 0

    while True:
        try:
            client.loop()
        except Exception as e:
            print("[warn] loop() error:", e)
            break

        poll_dashboard()

        now = time.monotonic()
        process_command_queue(now)
        moving = active_command is not None or bool(command_queue)
        refresh_interval = MOVING_STATUS_REFRESH_SECONDS if moving else STATUS_REFRESH_SECONDS
        terminal_interval = MOVING_TERMINAL_STATUS_INTERVAL if moving else TERMINAL_STATUS_INTERVAL
        elapsed = now - last
        if elapsed >= refresh_interval:
            counter += 1
            status = gather_status(now)
            ping_ms = int(elapsed * 1000)
            status["ping_ms"] = ping_ms
            status["ping"] = counter
            status["seq"] = counter
            last_status = status
            update_dashboard_status(status)
            if now - last_terminal_print >= terminal_interval:
                print_status(status)
                last_terminal_print = now
            if status_publish_enabled:
                try:
                    client.publish(TOPIC_PUB, json.dumps(status))
                except Exception as e:
                    print("[warn] publish() fallo:", e)
            last = now

        time.sleep(0.02)

if __name__ == "__main__":
    main()
