class Motor():
    def __init__(self):
        pass

    def _speed_to_duty(self, speed):
        speed = max(0, min(100, speed))
        return int(map(speed, 100, 0, PWM_MAX, 0))

    def _drive_motor(self, pwm, direction_pin, status, direction, speed):
        if status == 0:
            direction_pin.value = False
            pwm.duty_cycle = 0
            return

        value = self._speed_to_duty(speed)
        if direction == Dir_forward:
            direction_pin.value = False
            pwm.duty_cycle = value
        elif direction == Dir_backward:
            direction_pin.value = True
            pwm.duty_cycle = PWM_MAX - value

    '''
    (1, 1, 100) ---(status, direction, speed)
     |  |   |
     |  |   speed: value range 0~100.
     |  direction: 1(forward), -1(backward)
    status: 1(move), 0(stop)
    '''
    # Control the M1 motor (left front).
    def motor_left_front(self, status, direction, speed):
        '''
        if status == 0: # stop.
            Motor_LF_Dir.value = False
            Motor_LF_PWM.duty_cycle = 0
        else:
            value = int(map(speed,100,0,65535,0))
            if direction == Dir_forward: # 1, motor forward.
                Motor_LF_Dir.value = False
                Motor_LF_PWM.duty_cycle = value
            elif direction == Dir_backward: # -1, motor backward.
                otor_LF_Dir.value = True
                Motor_LF_PWM.duty_cycle = 65535 - value
        '''
        self._drive_motor(Motor_LF_PWM, Motor_LF_Dir, status, direction, speed)

    # Control the M2 motor (right front).
    def motor_right_front(self, status, direction, speed):
        '''
        if status == 0: # stop.
            Motor_RF_Dir.value = False
            Motor_RF_PWM.duty_cycle = 0
        else:
            value = int(map(speed,0,100,0,65535))
            Motor_RF_PWM.freq(500)
            if direction == Dir_forward:
                Motor_RF_Dir.value = False
                Motor_RF_PWM.duty_cycle = value
            elif direction == Dir_backward:
                Motor_RF_Dir.value = True
                Motor_RF_PWM.duty_cycle = 65535-value
        '''
        self._drive_motor(Motor_RF_PWM, Motor_RF_Dir, status, direction, speed)

    # Control the M3 motor (right back).
    def motor_right_back(self, status, direction, speed):
        '''
        if status == 0: # stop.
            Motor_RB_Dir.value = False
            Motor_RB_PWM.duty_cycle = 0
        else:
            value = int(map(speed,0,100,0,65535))
            if direction == Dir_forward:
                Motor_RB_Dir.value = True
                Motor_RB_PWM.duty_cycle = 65535-value
            elif direction == Dir_backward:
                Motor_RB_Dir.value = False
                Motor_RB_PWM.duty_cycle =value
        '''
        self._drive_motor(Motor_RB_PWM, Motor_RB_Dir, status, direction, speed)

    # Control the M4 motor (left back).
    def motor_left_back(self, status, direction, speed):
        '''
        if status == 0: # stop.
            Motor_LB_Dir.value = False
            Motor_LB_PWM.duty_cycle = 0
        else:
            value = int(map(speed,0,100,0,65535))
            if direction == Dir_forward:
                Motor_LB_Dir.value = True
                Motor_LB_PWM.duty_cycle = 65535-value
            elif direction == Dir_backward:
                Motor_LB_Dir.value = False
                Motor_LB_PWM.duty_cycle = value
        '''
        self._drive_motor(Motor_LB_PWM, Motor_LB_Dir, status, direction, speed)

