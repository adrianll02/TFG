class DisplayLetter:
    def __init__(self):
        self.i2c = _get_shared_i2c()
        self.display = matrix.Matrix16x8(self.i2c)

    def show_letters(self, letter_A, letter_B):
        for row in range(8):
            for col in range(8):
                if (letter_A[row] >> col) & 0x01:
                    self.display.pixel(col, row, 1)

                if (letter_B[row] >> col) & 0x01:
                    self.display.pixel(col+8, row, 1)

        self.display.show()

    def cleanup(self):
        self.i2c.deinit()


