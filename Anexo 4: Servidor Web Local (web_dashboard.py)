def _sanitize_for_json(value):
    """Return data that json.dumps() can encode reliably."""
    if isinstance(value, dict):
        return {key: _sanitize_for_json(val) for key, val in value.items()}
    if isinstance(value, (list, tuple, set)):
        return [_sanitize_for_json(val) for val in value]
    if isinstance(value, float):
        if not math.isfinite(value):
            return None
        return float(value)
    if isinstance(value, bytes):
        try:
            return value.decode("utf-8", "ignore")
        except Exception:
            return None
    if isinstance(value, memoryview):
        return _sanitize_for_json(bytes(value))
    return value

def start_dashboard(
    pool,
    wifi_radio,
    port,
    handle_command_cb,
    status_getter,
    format_status_lines,
    auth_user=None,
    auth_password=None,
):
    """Initialize HTTP dashboard server/state."""
    _state["pool"] = pool
    _state["wifi"] = wifi_radio
    _state["port"] = port
    _state["handle_command"] = handle_command_cb
    _state["status_getter"] = status_getter
    _state["format_status_lines"] = format_status_lines
    _state["auth_user"] = str(auth_user) if auth_user else None
    _state["auth_password"] = str(auth_password) if auth_password else None
    _state["auth_session"] = None
    refresh_status()
    _init_server()

def update_dashboard_status(status):
    if status is not None:
        _state["status"] = status

def refresh_status():
    getter = _state.get("status_getter")
    if getter is None:
        return
    try:
        snapshot = getter()
    except Exception:
        snapshot = None
    if snapshot is not None:
        _state["status"] = snapshot

def poll_dashboard():
    server = _state.get("socket")
    if server is None:
        return
    try:
        conn, _addr = server.accept()
    except OSError:
        return
    except Exception as err:
        print("[warn] HTTP accept error:", err)
        return

    try:
        conn.settimeout(1)
    except Exception:
        pass

    try:
        buf = bytearray(1024)
        length = conn.recv_into(buf)
    except Exception as err:
        err_code = getattr(err, "errno", None)
        err_text = str(err).upper()
        if err_code in (11, 116) or "EAGAIN" in err_text or "ETIMEDOUT" in err_text:
            try:
                conn.close()
            except Exception:
                pass
            return
        print("[warn] HTTP recv error:", err)
        try:
            conn.close()
        except Exception:
            pass
        return

    if not length:
        try:
            conn.close()
        except Exception:
            pass
        return

    request = bytes(memoryview(buf)[:length])
    try:
        first_line = request.split(b"\r\n", 1)[0].decode("utf-8", "ignore")
    except Exception:
        first_line = ""

    method = "GET"
    path = "/"
    if first_line:
        parts = first_line.split()
        if len(parts) >= 2:
            method = parts[0]
            path = parts[1]

    route, _, query = path.partition("?")
    # Normalizar rutas triviales del navegador
    if route == "/favicon.ico":
        # Responder rapido con 404 sin tocar autenticacion
        try:
            _send_all(conn, build_http_response("", "404 Not Found", "text/plain; charset=utf-8", [("Cache-Control", "no-store")]))
            try:
                time.sleep(0.05)
            except Exception:
                pass
        finally:
            try:
                conn.close()
            except Exception:
                pass
        return
    headers = _parse_headers(request)

    authorized, auth_response = _check_authorization(route, query, headers)
    if not authorized:
        body_resp, status_resp, content_resp, extra_resp = auth_response
        try:
            _send_all(conn, build_http_response(body_resp, status_resp, content_resp, extra_resp))
            try:
                time.sleep(0.05)
            except Exception:
                pass
        except Exception as err:
            print("[warn] HTTP auth send error:", err)
        finally:
            try:
                conn.close()
            except Exception:
                pass
        return

    status_code = "200 OK"
    content_type = "text/html; charset=utf-8"
    base_headers = [("Cache-Control", "no-store")]
    extra_headers = list(base_headers)
    message = None
    body = None

    status_snapshot = _ensure_status()

    if route == "/status.json":
        payload = dict(status_snapshot) if isinstance(status_snapshot, dict) else {}
        if _state["format_status_lines"]:
            try:
                payload["_text"] = _state["format_status_lines"](status_snapshot)
            except Exception:
                payload["_text"] = []
        payload = _sanitize_for_json(payload)
        body = json.dumps(payload)
        content_type = "application/json"
    elif route in ("/", ""):
        message = get_query_param(query, "msg")
        body = render_dashboard(status_snapshot, message)
    elif route == "/command" and method == "GET":
        cmd_value = get_query_param(query, "cmd")
        if not cmd_value:
            servo_value = get_query_param(query, "servo")
            if servo_value is not None and servo_value != "":
                cmd_value = "servo " + servo_value
        if cmd_value:
            handled, note = _handle_command(cmd_value)
            safe_note = (note or "")[:120]
            is_ajax = headers.get("x-command-request") == "ajax"
            if is_ajax:
                body = json.dumps({
                    "handled": bool(handled),
                    "note": safe_note,
                })
                content_type = "application/json"
                extra_headers = list(base_headers)
            else:
                status_code = "303 See Other"
                fallback_note = safe_note or ("OK" if handled else "Comando sin nota")
                redirect_target = "/?msg=" + url_encode(fallback_note)
                body = "<!DOCTYPE html><html><head><meta http-equiv='refresh' content='0; url=%s'></head><body><p>%s</p></body></html>" % (redirect_target, html_escape(fallback_note))
                content_type = "text/html; charset=utf-8"
                extra_headers = [("Cache-Control", "no-store"), ("Location", redirect_target)]
        else:
            status_code = "400 Bad Request"
            body = json.dumps({"handled": False, "note": "Proporciona ?cmd="})
            content_type = "application/json"
    else:
        status_code = "404 Not Found"
        body = "<!DOCTYPE html><html><body><h1>404</h1><p>Recurso no encontrado.</p></body></html>"

    try:
        _send_all(conn, build_http_response(body, status_code, content_type, extra_headers))
        # Pequeño retardo para estabilidad de red en microcontrolador
        try:
            time.sleep(0.05)
        except Exception:
            pass
    except Exception as err:
        print("[warn] HTTP send error:", err)
    finally:
        try:
            conn.close()
        except Exception:
            pass

def _handle_command(cmd_value):
    handler = _state.get("handle_command")
    if handler is None:
        return False, "Sin handler"
    handled, note = handler(cmd_value)
    if handled:
        print(f"[info] Comando web: {cmd_value}")
    else:
        print(f"[warn] Comando desconocido (web): {cmd_value}")
    refresh_status()
    return handled, note

def _init_server():
    pool = _state.get("pool")
    wifi_radio = _state.get("wifi")
    port = _state.get("port", 80)
    if pool is None or wifi_radio is None:
        return
    try:
        sock = pool.socket(pool.AF_INET, pool.SOCK_STREAM)
        try:
            sol_socket = getattr(pool, "SOL_SOCKET", None)
            so_reuseaddr = getattr(pool, "SO_REUSEADDR", None)
            if sol_socket is not None and so_reuseaddr is not None:
                sock.setsockopt(sol_socket, so_reuseaddr, 1)
        except Exception:
            pass
        sock.bind(("0.0.0.0", port))
        sock.listen(2)
        sock.settimeout(0)
        _state["socket"] = sock
        print(f"[🌍] HTTP listo en http://{wifi_radio.ipv4_address}:{port}")
    except Exception as err:
        _state["socket"] = None
        print("[warn] HTTP server init error:", err)

def _ensure_status():
    status_snapshot = _state.get("status")
    if status_snapshot is None:
        refresh_status()
        status_snapshot = _state.get("status")
    if status_snapshot is None:
        status_snapshot = {}
    return status_snapshot

def _parse_headers(request_bytes):
    headers = {}
    try:
        head, _ = request_bytes.split(b"\r\n\r\n", 1)
    except ValueError:
        head = request_bytes
    lines = head.split(b"\r\n")[1:]
    for raw in lines:
        if b":" not in raw:
            continue
        name, value = raw.split(b":", 1)
        try:
            key = name.decode("utf-8", "ignore").strip().lower()
            val = value.decode("utf-8", "ignore").strip()
            headers[key] = val
        except Exception:
            continue
    return headers

def _parse_cookies(cookie_header):
    cookies = {}
    if not cookie_header:
        return cookies
    parts = cookie_header.split(";")
    for part in parts:
        segment = part.strip()
        if not segment:
            continue
        name, _, value = segment.partition("=")
        if not name:
            continue
        cookies[name] = value
    return cookies

def url_decode(text):
    if text is None:
        return ""
    result = []
    i = 0
    length = len(text)
    while i < length:
        ch = text[i]
        if ch == "+":
            result.append(" ")
            i += 1
            continue
        if ch == "%" and i + 2 < length:
            hex_value = text[i + 1:i + 3]
            try:
                result.append(chr(int(hex_value, 16)))
                i += 3
                continue
            except Exception:
                pass
        result.append(ch)
        i += 1
    return "".join(result)

def url_encode(text):
    if text is None:
        return ""
    safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
    out = []
    for ch in str(text):
        if ch in safe:
            out.append(ch)
        elif ch == " ":
            out.append("+")
        else:
            out.append("%02X" % ord(ch))
    return "".join(out)

def html_escape(text):
    if text is None:
        return ""
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

def get_query_param(query, name):
    if not query:
        return None
    target = name + "="
    for part in query.split("&"):
        if part.startswith(target):
            return url_decode(part[len(target):])
    return None

