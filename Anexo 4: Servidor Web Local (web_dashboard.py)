def _check_authorization(route, query, headers):
    username = _state.get("auth_user")
    password = _state.get("auth_password")
    if username is None and password is None:
        return True, None

    session_token = _state.get("auth_session")
    cookies = _parse_cookies(headers.get("cookie"))
    if session_token and cookies.get("dash_session") == session_token:
        return True, None

    provided_user = get_query_param(query, "user") if query else None
    provided_pass = get_query_param(query, "password") if query else None
    submitted = (provided_user is not None) or (provided_pass is not None)

    if submitted:
        user_value = provided_user or ""
        pass_value = provided_pass or ""
        missing = False
        if username is not None and not user_value:
            missing = True
        if password is not None and not pass_value:
            missing = True
        user_ok = (username is None) or (user_value == username)
        pass_ok = (password is None) or (pass_value == password)
        if not missing and user_ok and pass_ok:
            token = str(int(time.monotonic() * 1000))
            _state["auth_session"] = token
            redirect_target = "/"
            headers = [
                ("Location", redirect_target),
                ("Set-Cookie", "dash_session=%s; Max-Age=86400; Path=/" % token),
                ("Cache-Control", "no-store"),
            ]
            body = "<!DOCTYPE html><html><head><meta http-equiv='refresh' content='0; url=%s'></head><body><p>Acceso concedido</p></body></html>" % redirect_target
            return False, (body, "303 See Other", "text/html; charset=utf-8", headers)

        error_text = "Introduce usuario y contraseña" if missing else "Credenciales incorrectas"
        body = render_login_page(error_text, user_value)
        headers = [("Cache-Control", "no-store")]
        return False, (body, "401 Unauthorized", "text/html; charset=utf-8", headers)

    prefill_user = username or ""
    body = render_login_page(None, prefill_user)
    headers = [("Cache-Control", "no-store")]
    return False, (body, "401 Unauthorized", "text/html; charset=utf-8", headers)

