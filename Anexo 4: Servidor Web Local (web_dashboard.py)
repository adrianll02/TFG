def build_http_response(body, status="200 OK", content_type="text/html; charset=utf-8", extra_headers=None):
    if isinstance(body, str):
        body_bytes = body.encode("utf-8")
    else:
        body_bytes = body or b""
    lines = [
        f"HTTP/1.1 {status}",
        f"Content-Type: {content_type}",
        f"Content-Length: {len(body_bytes)}",
        "Connection: close",
    ]
    if extra_headers:
        for key, value in extra_headers:
            lines.append(f"{key}: {value}")
    lines.extend(["", ""])
    header_bytes = "\r\n".join(lines).encode("utf-8")
    return header_bytes + body_bytes

def _send_all(conn, payload):
    if not payload:
        return
    view = memoryview(payload)
    total = len(view)
    sent = 0
    max_chunk = 1024
    backoff = 0.01
    while sent < total:
        try:
            end = sent + max_chunk
            written = conn.send(view[sent:end])
        except Exception as err:
            print("[warn] HTTP send chunk error:", err)
            break
        if not written:
            try:
                time.sleep(backoff)
            except Exception:
                pass
            continue
        sent += written
    if sent < total:
        print("[warn] HTTP response truncated (sent %d of %d bytes)" % (sent, total))
